<UserControl x:Class="PortableCodex.Native.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="56,44,56,44" MaxWidth="620" HorizontalAlignment="Center">

            <!-- Hero heading -->
            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="36" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource PageHeading}" Text="Set up your relay" />
            <TextBlock Style="{StaticResource PageSubheading}" Margin="0,8,0,40"
                       Text="We'll connect your machine to ChatGPT via a local relay and Tailscale Funnel." />

            <!-- ── Status timeline ── -->
            <TextBlock Text="STATUS" Style="{StaticResource SectionLabel}" Margin="0,0,0,18" />

            <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Connecting rails -->
                    <Rectangle Grid.Column="0" Grid.Row="0" Width="2" RadiusX="1" RadiusY="1"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,26,0,-2">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{DynamicResource WarningSubtleFg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CredentialsReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Rectangle Grid.Column="0" Grid.Row="1" Width="2" RadiusX="1" RadiusY="1"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,26,0,-2"
                               Fill="{Binding LocalRelayState, Converter={StaticResource StatusDot}}" />

                    <!-- Stage 1: Credentials -->
                    <Grid Grid.Column="0" Grid.Row="0" Width="26" Height="26" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource CardMutedBg}" Stroke="{DynamicResource SubtleBorder}" StrokeThickness="1" />
                        <Ellipse x:Name="Cred" Width="10" Height="10">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource WarningSubtleFg}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CredentialsReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <ui:SymbolIcon x:Name="CredCheck" Symbol="Checkmark20" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding CredentialsReady, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="14,0,0,28">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Generating credentials…" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CredentialsReady}" Value="True">
                                        <Setter Property="Text" Value="Credentials ready" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TertiaryFg}" Margin="0,4,0,0" Text="{Binding DeviceId}" />
                    </StackPanel>

                    <!-- Stage 2: Local relay -->
                    <Grid Grid.Column="0" Grid.Row="1" Width="26" Height="26" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource CardMutedBg}" Stroke="{DynamicResource SubtleBorder}" StrokeThickness="1" />
                        <Ellipse Width="10" Height="10" Fill="{Binding LocalRelayState, Converter={StaticResource StatusDot}}" />
                        <ui:SymbolIcon Symbol="Checkmark20" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding RelayReady, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="14,0,0,28">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Starting local relay…" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelayReady}" Value="True">
                                        <Setter Property="Text" Value="Local relay running" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TertiaryFg}" Margin="0,4,0,0" Text="{Binding LocalRelayMessage}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Stage 3: Funnel -->
                    <Grid Grid.Column="0" Grid.Row="2" Width="26" Height="26" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource CardMutedBg}" Stroke="{DynamicResource SubtleBorder}" StrokeThickness="1" />
                        <Ellipse Width="10" Height="10" Fill="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                        <ui:SymbolIcon Symbol="Checkmark20" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding TunnelReady, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="14,0,0,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Waiting to connect…" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TunnelReady}" Value="True"><Setter Property="Text" Value="Connected to ChatGPT" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TunnelState}" Value="starting"><Setter Property="Text" Value="Configuring Tailscale Funnel…" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TunnelState}" Value="not_found"><Setter Property="Text" Value="Install Tailscale" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TunnelState}" Value="login_required"><Setter Property="Text" Value="Sign in to Tailscale" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TunnelState}" Value="approval_required"><Setter Property="Text" Value="Approve Funnel access" /></DataTrigger>
                                    <DataTrigger Binding="{Binding TunnelState}" Value="error"><Setter Property="Text" Value="Funnel error" /></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TertiaryFg}" Margin="0,4,0,0" Text="{Binding TunnelMessage}" TextWrapping="Wrap" />
                    </StackPanel>
            </Grid>

            <!-- ── Tailscale Connection ── -->
            <StackPanel Margin="0,0,0,0">
                <DockPanel Margin="0,0,0,14">
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Globe24" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tailscale Funnel" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock FontSize="13" Foreground="{DynamicResource MutedFg}" Margin="0,0,0,18" TextWrapping="Wrap" LineHeight="20" Text="{Binding TunnelModeSummary}" />

                <!-- Install (when not found) -->
                <StackPanel Visibility="{Binding TunnelState, Converter={StaticResource StateVisibility}, ConverterParameter=not_found}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedFg}" Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="20"
                               Text="Tailscale is not installed. Click below to install it automatically or visit tailscale.com/download." />
                    <ui:Button Appearance="Primary" Content="Install Tailscale" Command="{Binding InstallTailscaleCommand}" />
                </StackPanel>

                <!-- Normal flow -->
                <StackPanel Visibility="{Binding TunnelState, Converter={StaticResource StateVisibilityInverted}, ConverterParameter=not_found}">
                    <!-- Instructions -->
                    <Border Background="{DynamicResource CardMutedBg}" CornerRadius="6" Padding="16,14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="{DynamicResource SecondaryFg}" Margin="0,0,0,6" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">1.</Run>
                                <Run>  Install Tailscale and sign in to join your tailnet.</Run>
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="{DynamicResource SecondaryFg}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">2.</Run>
                                <Run>  Click Connect below. The app starts Funnel and handles approval.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Tunnel URL when connected -->
                    <DockPanel Margin="0,0,0,14" Visibility="{Binding TunnelReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center" Text="URL  " />
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="11" Content="{Binding TunnelCopiedLabel}" Command="{Binding CopyTunnelUrlCommand}" />
                        <TextBlock FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource SecondaryFg}" Text="{Binding TunnelUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>

                    <ui:Button Appearance="Primary" Content="Connect to Tailscale" Command="{Binding ApplyTunnelSettingsCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Error banner -->
            <Border CornerRadius="6" Padding="14,10" Margin="0,20,0,0"
                    Background="{DynamicResource ErrorSubtleBg}" BorderBrush="{DynamicResource ErrorSubtleBorder}" BorderThickness="1">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorBanner}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style></Border.Style>
                <TextBlock Foreground="{DynamicResource ErrorSubtleFg}" FontSize="13" Text="{Binding ErrorBanner}" TextWrapping="Wrap" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
