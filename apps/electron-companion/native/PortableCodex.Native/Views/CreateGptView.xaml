<UserControl x:Class="PortableCodex.Native.Views.CreateGptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="56,44,56,44" MaxWidth="680" HorizontalAlignment="Center">

            <!-- Hero -->
            <ui:SymbolIcon Symbol="Apps24" FontSize="36" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource PageHeading}" Text="Choose integration" />
            <TextBlock Style="{StaticResource PageSubheading}" Margin="0,8,0,36"
                       Text="Pick how ChatGPT connects to your machine. Custom GPT Action is recommended for most users." />

            <!-- ── Option Cards ── -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- GPT Action card -->
                <Border Grid.Column="0" CornerRadius="6" Padding="20,18" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLegacyIntegrationSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Star24" FontSize="18" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Custom GPT Action" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Recommended" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SuccessSubtleFg}" Margin="0,0,0,10" />
                        <TextBlock Text="Paste a system prompt, OpenAPI schema, and bearer token into a Custom GPT." FontSize="12" Foreground="{DynamicResource MutedFg}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />
                        <ui:Button Appearance="Primary" HorizontalAlignment="Left" FontSize="12" Content="Select" Command="{Binding SelectIntegrationModeCommand}" CommandParameter="legacy_action" />
                    </StackPanel>
                </Border>

                <!-- MCP card -->
                <Border Grid.Column="2" CornerRadius="6" Padding="20,18" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBg}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMcpIntegrationSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PlugConnected24" FontSize="18" Foreground="{DynamicResource WarningSubtleFg}" Margin="0,0,8,0" />
                            <TextBlock Text="ChatGPT App" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Beta" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource WarningSubtleFg}" Margin="0,0,0,10" />
                        <TextBlock Text="Use the Apps SDK / MCP connector. Only if you need Pro model access through the app flow." FontSize="12" Foreground="{DynamicResource MutedFg}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Left" FontSize="12" Content="Select" Command="{Binding SelectIntegrationModeCommand}" CommandParameter="mcp" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Divider}" Margin="0,24" />

            <!-- ── Setup Instructions ── -->

            <!-- MCP flow instructions -->
            <StackPanel Visibility="{Binding IsMcpIntegrationSelected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SETUP STEPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,18" />

                <Border Background="{DynamicResource WarningSubtleBg}" CornerRadius="6" Padding="14,10" Margin="0,0,0,20">
                    <TextBlock Text="This is a beta integration. Use Custom GPT Action unless you specifically need Pro model access." FontSize="12" Foreground="{DynamicResource WarningSubtleFg}" TextWrapping="Wrap" />
                </Border>

                <DockPanel Margin="0,0,0,16">
                    <Grid DockPanel.Dock="Left" Style="{StaticResource StepCircle}">
                        <Ellipse Fill="{DynamicResource AccentBrush}" /><TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" TextWrapping="Wrap">
                            <Run>Go to</Run> <Run FontWeight="SemiBold">Settings → Connectors</Run> <Run>and create a custom connector</Run>
                        </TextBlock>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="12" Content="Open ChatGPT →" Command="{Binding OpenGptBuilderCommand}" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,16">
                    <Grid DockPanel.Dock="Left" Style="{StaticResource StepCircle}">
                        <Ellipse Fill="{DynamicResource AccentBrush}" /><TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run>Select MCP, name it</Run> <Run FontWeight="SemiBold">Portable Codex</Run>
                    </TextBlock>
                </DockPanel>

                <DockPanel>
                    <Grid DockPanel.Dock="Left" Style="{StaticResource StepCircle}">
                        <Ellipse Fill="{DynamicResource AccentBrush}" /><TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run>Copy the endpoint and token on the next page</Run>
                    </TextBlock>
                </DockPanel>
            </StackPanel>

            <!-- Legacy GPT flow instructions -->
            <StackPanel Visibility="{Binding IsLegacyIntegrationSelected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SETUP STEPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,18" />

                <DockPanel Margin="0,0,0,16">
                    <Grid DockPanel.Dock="Left" Style="{StaticResource StepCircle}">
                        <Ellipse Fill="{DynamicResource AccentBrush}" /><TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel>
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" TextWrapping="Wrap">
                            <Run>Go to</Run> <Run FontWeight="SemiBold">GPTs → Create → Configure</Run>
                        </TextBlock>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Left" Margin="0,6,0,0" FontSize="12" Content="Open ChatGPT →" Command="{Binding OpenGptBuilderCommand}" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,8">
                    <Grid DockPanel.Dock="Left" Style="{StaticResource StepCircle}">
                        <Ellipse Fill="{DynamicResource AccentBrush}" /><TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <Run>Paste the system prompt into</Run> <Run FontWeight="SemiBold">Instructions</Run>
                    </TextBlock>
                </DockPanel>

                <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center" Text="System prompt" />
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="11" Content="{Binding InstructionsCopiedLabel}" Command="{Binding CopyInstructionsCommand}" />
                            <TextBlock />
                        </DockPanel>
                    </ui:CardExpander.Header>
                    <TextBox Style="{StaticResource CodeBox}" Background="Transparent" BorderThickness="0" MaxHeight="250" Padding="14,12" VerticalScrollBarVisibility="Auto" Text="{Binding GptInstructions, Mode=OneWay}" />
                </ui:CardExpander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
