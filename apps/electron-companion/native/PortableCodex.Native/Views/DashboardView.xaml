<UserControl x:Class="PortableCodex.Native.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="300" />
            <!-- Divider -->
            <ColumnDefinition Width="1" />
            <!-- Main -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,24,24,24">

                    <!-- ── Connection ── -->
                    <DockPanel Margin="0,0,0,16">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PlugConnected24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Connection" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Relay -->
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Left" Width="7" Height="7" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{Binding RelayConnectionState, Converter={StaticResource StatusDot}}" />
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" Text="Relay" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TertiaryFg}" Text="{Binding RelayConnectionMessage}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Public URL -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding TunnelReady, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="7" Height="7" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Background="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" Text="Funnel" />
                        </DockPanel>
                        <TextBlock FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TertiaryFg}" Text="{Binding TunnelUrl}" TextTrimming="CharacterEllipsis" Margin="17,3,0,0" />
                        <ui:Button Appearance="Transparent" FontSize="10" HorizontalAlignment="Left" Margin="13,2,0,0" Padding="4,2" Content="{Binding TunnelCopiedLabel}" Command="{Binding CopyTunnelUrlCommand}" />
                    </StackPanel>

                    <!-- Device ID -->
                    <DockPanel Margin="0,0,0,0">
                        <Border DockPanel.Dock="Left" Width="7" Height="7" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{DynamicResource SuccessSubtleBorder}" />
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryFg}" Text="Device" />
                            <TextBlock FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TertiaryFg}" Text="{Binding DeviceId}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- ── Workspaces ── -->
                    <DockPanel Margin="0,0,0,12">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="10" Padding="6,2" Content="+ Add" Command="{Binding AddWorkspaceCommand}" />
                        <TextBlock Text="Workspaces" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ComboBox FontSize="12" HorizontalAlignment="Stretch" ItemsSource="{Binding CurrentWorkspaceChoices}" SelectedItem="{Binding CurrentWorkspace, Mode=TwoWay}"
                              Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryFg}" Margin="0,0,0,8" Text="No folders added."
                               Visibility="{Binding HasWorkspaces, Converter={StaticResource InverseBoolToVis}}" />
                    <CheckBox FontSize="12" Foreground="{DynamicResource MutedFg}" IsChecked="{Binding ImportCodexCliWorkspaces}" Content="Sync from Codex CLI" />

                    <Border Style="{StaticResource Divider}" />

                    <!-- ── Skills ── -->
                    <DockPanel Margin="0,0,0,10">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Lightbulb24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="10" Padding="6,2" Content="+ Add" Command="{Binding AddSkillCommand}" />
                        <TextBlock Text="Skills" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock FontSize="11" Foreground="{DynamicResource TertiaryFg}" Margin="0,0,0,8" Text="{Binding SkillSummaryText}" TextWrapping="Wrap" />
                    <CheckBox FontSize="12" Foreground="{DynamicResource MutedFg}" Margin="0,0,0,8" IsChecked="{Binding ImportCodexCliSkills}" Content="Sync from Codex CLI" />

                    <!-- Skills list -->
                    <ItemsControl ItemsSource="{Binding Skills}" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="SkillChip" Margin="0,0,6,6">
                                    <Button Style="{StaticResource SkillChipButton}"
                                            FontSize="11"
                                            Content="{Binding Activation}"
                                            Command="{Binding DataContext.ViewSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="View SKILL.md" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            ToolTip="Remove skill"
                                            Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Path}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SkillChipRemoveButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SkillChip}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="IsHitTestVisible" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" />

                    <ui:Button Appearance="Transparent" FontSize="11" HorizontalAlignment="Left" Content="Allow full system access" Command="{Binding TrustWholeSystemCommand}" />
                    <ui:Button Appearance="Transparent" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0" Foreground="{DynamicResource TertiaryFg}" Content="Re-run setup wizard" Command="{Binding ReturnToSetupCommand}" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Vertical divider -->
        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <!-- ══════════════════════════════════════════════════
             MAIN PANEL — Activity
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <DockPanel Grid.Row="0" Margin="28,24,28,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryFg}" VerticalAlignment="Center" Margin="0,0,6,0" Text="Filter" />
                    <ComboBox MinWidth="100" FontSize="12" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" Text="Activity" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryFg}" Margin="0,4,0,0" Text="Tool invocations from ChatGPT appear here in real time." />
                </StackPanel>
            </DockPanel>

            <!-- ── Log Area ── -->
            <Grid Grid.Row="1" Margin="28,0,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- File search progress -->
                <Border Grid.Row="0" Padding="14,10" Margin="0,0,0,12" CornerRadius="6"
                        Background="{DynamicResource SuccessSubtleBg}" BorderBrush="{DynamicResource SuccessSubtleBorder}" BorderThickness="1"
                        Visibility="{Binding IsFileSearchInProgress, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessSubtleFg}" Text="File search" />
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource SuccessSubtleFg}" Text="{Binding FileSearchProgressValue, StringFormat={}{0:0}%}" />
                            <TextBlock />
                        </DockPanel>
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding FileSearchProgressValue, Mode=OneWay}" Foreground="{DynamicResource SuccessSubtleBorder}" Background="{DynamicResource CardMutedBg}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SuccessSubtleFg}" Text="{Binding FileSearchProgressText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                            Visibility="{Binding HasActivityLogs, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon Symbol="ClipboardTextLtr24" FontSize="40" Foreground="{DynamicResource TertiaryFg}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryFg}" TextAlignment="Center" HorizontalAlignment="Center" Text="No activity yet" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryFg}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="When ChatGPT calls a tool, each invocation will show here." />
                </StackPanel>

                <!-- Log list -->
                <ListView ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog, Mode=TwoWay}" Grid.Row="1"
                          BorderThickness="0" Background="Transparent" FontSize="13" Margin="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasActivityLogs, Converter={StaticResource BoolToVis}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Padding="14,12" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" Text="{Binding ToolDisplay}" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TertiaryFg}" Margin="10,2,0,0" Text="{Binding CreatedAtDisplay}" />
                                    </DockPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedFg}" Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <!-- Status pill -->
                                <Border Grid.Column="1" Padding="8,3" Margin="10,0,0,0" CornerRadius="4" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Background" Value="{DynamicResource PendingSubtleBg}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="error"><Setter Property="Background" Value="{DynamicResource ErrorSubtleBg}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="denied"><Setter Property="Background" Value="{DynamicResource ErrorSubtleBg}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="timeout"><Setter Property="Background" Value="{DynamicResource WarningSubtleBg}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding StatusDisplay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessSubtleFg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Foreground" Value="{DynamicResource MutedFg}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="denied"><Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="timeout"><Setter Property="Foreground" Value="{DynamicResource WarningSubtleFg}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ── Bottom bar: detail + actions ── -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="28,14,28,14">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource TertiaryFg}" Text="SELECTED ENTRY" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" FontSize="11" Margin="0,0,4,0" Content="{Binding ActivityLogToggleText}" Command="{Binding ToggleActivityLogCommand}"
                                       Visibility="{Binding HasActivityLogs, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Appearance="Secondary" FontSize="11" Content="Diff viewer" Command="{Binding ViewDiffViewerCommand}" />
                        </StackPanel>
                        <TextBlock />
                    </DockPanel>
                    <TextBox Style="{StaticResource CodeBox}" Background="Transparent" BorderThickness="0" Padding="0"
                             MinHeight="60" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedLogDetail, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
