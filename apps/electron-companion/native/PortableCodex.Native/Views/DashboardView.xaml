<UserControl x:Class="PortableCodex.Native.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Background="{DynamicResource AppBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="324" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════
             SIDEBAR — grouped cards
             ══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,24,20,24">

                    <!-- ── Connection ── -->
                    <DockPanel Margin="0,0,0,16">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="PlugConnected24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="Connection" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Relay -->
                    <DockPanel Margin="0,0,0,14">
                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,5,11,0" VerticalAlignment="Top"
                                Background="{Binding RelayConnectionState, Converter={StaticResource StatusDot}}" />
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PrimaryFg}" Text="Relay" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding RelayConnectionMessage}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Public URL -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding TunnelReady, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,11,0" VerticalAlignment="Center"
                                    Background="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PrimaryFg}" Text="Funnel" />
                        </DockPanel>
                        <TextBlock FontSize="10.5" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TertiaryFg}" Text="{Binding TunnelUrl}" TextTrimming="CharacterEllipsis" Margin="19,5,0,0" />
                        <ui:Button Appearance="Transparent" FontSize="10.5" HorizontalAlignment="Left" Margin="17,4,0,0" Padding="0,2" Content="{Binding TunnelCopiedLabel}" Command="{Binding CopyTunnelUrlCommand}" />
                    </StackPanel>

                    <!-- Funnel recovery -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowTunnelRecovery, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,11,0" VerticalAlignment="Center"
                                    Background="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PrimaryFg}" Text="Funnel" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TunnelMessage}" Margin="19,4,0,0" TextWrapping="Wrap" />
                        <ui:Button Appearance="Primary" FontSize="11" HorizontalAlignment="Left" Margin="19,9,0,0" Padding="9,4"
                                   Content="{Binding TunnelReconnectButtonText}"
                                   Command="{Binding ApplyTunnelSettingsCommand}" />
                    </StackPanel>

                    <!-- Device -->
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,5,11,0" VerticalAlignment="Top"
                                Background="{DynamicResource SuccessBrush}" />
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PrimaryFg}" Text="Device" />
                            <TextBlock FontSize="10.5" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TertiaryFg}" Text="{Binding DeviceId}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,22" />

                    <!-- ── Workspaces ── -->
                    <DockPanel Margin="0,0,0,14">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Folder24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="11" Padding="7,3" Content="+ Add" Command="{Binding AddWorkspaceCommand}" />
                        <TextBlock Text="Workspaces" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>

                    <ComboBox FontSize="12.5" HorizontalAlignment="Stretch" ItemsSource="{Binding CurrentWorkspaceChoices}" SelectedItem="{Binding CurrentWorkspace, Mode=TwoWay}"
                              Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" Text="No folders added."
                               Visibility="{Binding HasWorkspaces, Converter={StaticResource InverseBoolToVis}}" />
                    <CheckBox FontSize="12" Foreground="{DynamicResource MutedFg}" IsChecked="{Binding ImportCodexCliWorkspaces}" Content="Sync from Codex CLI" />

                    <Border Style="{StaticResource Divider}" Margin="0,22" />

                    <!-- ── Skills ── -->
                    <DockPanel Margin="0,0,0,12">
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Lightbulb24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" FontSize="11" Padding="7,3" Content="+ Add" Command="{Binding AddSkillCommand}" />
                        <TextBlock Text="Skills" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" Text="{Binding SkillSummaryText}" TextWrapping="Wrap" />
                    <CheckBox FontSize="12" Foreground="{DynamicResource MutedFg}" Margin="0,0,0,10" IsChecked="{Binding ImportCodexCliSkills}" Content="Sync from Codex CLI" />

                    <ItemsControl ItemsSource="{Binding Skills}" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="SkillChip" Margin="0,0,6,6">
                                    <Button Style="{StaticResource SkillChipButton}"
                                            FontSize="11"
                                            Content="{Binding Activation}"
                                            Command="{Binding DataContext.ViewSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="View SKILL.md" />
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            ToolTip="Remove skill"
                                            Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Path}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SkillChipRemoveButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SkillChip}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="IsHitTestVisible" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,22" />

                    <!-- ── Footer actions ── -->
                    <ui:Button Appearance="Transparent" FontSize="11" HorizontalAlignment="Left" Content="Allow full system access" Command="{Binding TrustWholeSystemCommand}" />
                    <ui:Button Appearance="Transparent" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0" Foreground="{DynamicResource TertiaryFg}" Content="Re-run setup wizard" Command="{Binding ReturnToSetupCommand}" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <!-- ══════════════════════════════════════════════════
             MAIN PANEL — Activity
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <DockPanel Grid.Row="0" Margin="30,26,30,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TertiaryFg}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Filter" />
                    <ComboBox MinWidth="110" FontSize="12" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryFg}" Text="Activity" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0" Text="Tool invocations from ChatGPT appear here in real time." />
                </StackPanel>
            </DockPanel>

            <!-- ── Log area ── -->
            <Grid Grid.Row="1" Margin="30,0,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- File search progress -->
                <Border Grid.Row="0" Padding="16,12" Margin="0,0,0,14" CornerRadius="0"
                        Background="{DynamicResource SuccessSubtleBg}" BorderBrush="{DynamicResource SuccessSubtleBorder}" BorderThickness="1"
                        Visibility="{Binding IsFileSearchInProgress, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessSubtleFg}" Text="File search" />
                            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource SuccessSubtleFg}" Text="{Binding FileSearchProgressValue, StringFormat={}{0:0}%}" />
                            <TextBlock />
                        </DockPanel>
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding FileSearchProgressValue, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource CardMutedBg}" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource SuccessSubtleFg}" Text="{Binding FileSearchProgressText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                            Visibility="{Binding HasActivityLogs, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="0" Background="{DynamicResource CardMutedBg}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ClipboardTextLtr24" FontSize="28" Foreground="{DynamicResource TertiaryFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryFg}" TextAlignment="Center" HorizontalAlignment="Center" Text="No activity yet" />
                    <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"
                               Text="When ChatGPT calls a tool, each invocation will show here." />
                </StackPanel>

                <!-- Log list -->
                <ListView ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog, Mode=TwoWay}" Grid.Row="1"
                          BorderThickness="0" Background="Transparent" FontSize="13" Margin="0" Padding="0,0,14,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasActivityLogs, Converter={StaticResource BoolToVis}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Padding="14,12" Background="Transparent" CornerRadius="0"
                                                BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Tool icon -->
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="0" Margin="0,0,13,0"
                                        Background="{DynamicResource CardMutedBg}" VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="Wrench24" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryFg}" Text="{Binding ToolDisplay}" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TertiaryFg}" Margin="10,2,0,0" Text="{Binding CreatedAtDisplay}" />
                                    </DockPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedFg}" Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Status pill -->
                                <Border Grid.Column="2" Padding="10,4" Margin="12,0,0,0" CornerRadius="0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBg}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessSubtleBorder}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Background" Value="{DynamicResource PendingSubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="error">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorSubtleBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="denied">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorSubtleBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="timeout">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningSubtleBorder}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Background" Value="{DynamicResource MutedFg}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="error"><Setter Property="Background" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="denied"><Setter Property="Background" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="timeout"><Setter Property="Background" Value="{DynamicResource WarningSubtleFg}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock FontSize="11" FontWeight="Medium" Text="{Binding StatusDisplay}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessSubtleFg}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="pending"><Setter Property="Foreground" Value="{DynamicResource MutedFg}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="denied"><Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="timeout"><Setter Property="Foreground" Value="{DynamicResource WarningSubtleFg}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ── Resizable splitter ── -->
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

            <!-- ── Detail panel ── -->
            <Border Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="30,16,30,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionLabel}" Text="SELECTED ENTRY" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" FontSize="11" Margin="0,0,6,0" Content="{Binding ActivityLogToggleText}" Command="{Binding ToggleActivityLogCommand}"
                                       Visibility="{Binding HasActivityLogs, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Appearance="Secondary" FontSize="11" Content="Diff viewer" Command="{Binding ViewDiffViewerCommand}" />
                        </StackPanel>
                        <TextBlock />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="1" CornerRadius="0" Padding="14,12">
                        <TextBox Style="{StaticResource CodeBox}" Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedLogDetail, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
