<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PortableCodex</AssemblyName>
    <Product>Portable Codex</Product>
    <!-- Single-file portable .exe on `dotnet publish` (see npm run build:exe / dist:win) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Bundled at build from repo docs/ (run `npm run docs:openapi` before building when OpenAPI changes) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\docs\openapi.actions.min.json">
      <LogicalName>PortableCodex_BundledOpenApi.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\docs\custom-gpt-instructions.md">
      <LogicalName>PortableCodex_GptInstructions.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

</Project>
