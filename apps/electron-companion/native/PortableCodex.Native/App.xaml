<Application x:Class="PortableCodex.Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:PortableCodex.Native.Utils"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <utils:StepVisibilityConverter x:Key="StepVisibility" />
            <utils:StepBrushConverter x:Key="StepBrush" />
            <utils:StepForegroundConverter x:Key="StepForeground" />
            <utils:StepLineBrushConverter x:Key="StepLineBrush" />
            <utils:BoolToVisibilityConverter x:Key="BoolToVis" />
            <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <utils:StatusDotBrushConverter x:Key="StatusDot" />
            <utils:StateVisibilityConverter x:Key="StateVisibility" />
            <utils:InverseStateVisibilityConverter x:Key="StateVisibilityInverted" />

            <!-- ═══════════════════════════════════════════
                 DESIGN TOKENS
                 All backgrounds are white-alpha to let Mica
                 show through. No opaque dark backgrounds.
                 ═══════════════════════════════════════════ -->

            <!-- Accent -->
            <SolidColorBrush x:Key="AccentBrush"          Color="#7C3AED" />
            <SolidColorBrush x:Key="AccentHoverBrush"      Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentSubtleBg"        Color="#187C3AED" />
            <SolidColorBrush x:Key="SuccessBrush"          Color="#10B981" />
            <SolidColorBrush x:Key="ErrorBrush"            Color="#F43F5E" />

            <!-- Surfaces — translucent layers over Mica -->
            <SolidColorBrush x:Key="AppBg"                 Color="Transparent" />
            <SolidColorBrush x:Key="PanelBg"               Color="#08FFFFFF" />
            <SolidColorBrush x:Key="CardBg"                Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="CardMutedBg"           Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ElevatedBg"            Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HoverBg"               Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SelectedBg"            Color="#187C3AED" />
            <SolidColorBrush x:Key="SelectedBorder"        Color="#407C3AED" />
            <SolidColorBrush x:Key="SurfaceBg"             Color="Transparent" />

            <!-- Text -->
            <SolidColorBrush x:Key="PrimaryFg"             Color="#FFFFFF" />
            <SolidColorBrush x:Key="SecondaryFg"           Color="#BBBBBB" />
            <SolidColorBrush x:Key="MutedFg"               Color="#888888" />
            <SolidColorBrush x:Key="TertiaryFg"            Color="#666666" />

            <!-- Borders — hairline -->
            <SolidColorBrush x:Key="SubtleBorder"          Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SoftBorder"            Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="DividerBrush"          Color="#0CFFFFFF" />

            <!-- Code -->
            <SolidColorBrush x:Key="CodeBg"                Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="CodeFg"                Color="#D4D4D4" />

            <!-- Semantic states — transparent tints -->
            <SolidColorBrush x:Key="SuccessSubtleBg"       Color="#1410B981" />
            <SolidColorBrush x:Key="SuccessSubtleBorder"   Color="#2810B981" />
            <SolidColorBrush x:Key="SuccessSubtleFg"       Color="#6EE7B7" />
            <SolidColorBrush x:Key="PendingSubtleBg"       Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="WarningSubtleBg"       Color="#14F59E0B" />
            <SolidColorBrush x:Key="WarningSubtleBorder"   Color="#28F59E0B" />
            <SolidColorBrush x:Key="WarningSubtleFg"       Color="#FDE68A" />
            <SolidColorBrush x:Key="ErrorSubtleBg"         Color="#14F43F5E" />
            <SolidColorBrush x:Key="ErrorSubtleBorder"     Color="#28F43F5E" />
            <SolidColorBrush x:Key="ErrorSubtleFg"         Color="#FDA4AF" />

            <!-- Step indicator -->
            <SolidColorBrush x:Key="StepActiveBg"          Color="#7C3AED" />
            <SolidColorBrush x:Key="StepCompleteBg"        Color="#10B981" />
            <SolidColorBrush x:Key="StepInactiveBg"        Color="#20FFFFFF" />
            <SolidColorBrush x:Key="StepLineActive"        Color="#7C3AED" />
            <SolidColorBrush x:Key="StepLineInactive"      Color="#15FFFFFF" />

            <!-- ═══════════════════════════════════════════
                 TYPOGRAPHY
                 ═══════════════════════════════════════════ -->

            <Style x:Key="PageHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
            </Style>

            <Style x:Key="PageSubheading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="22" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryFg}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
            </Style>

            <!-- ═══════════════════════════════════════════
                 COMPONENT STYLES
                 ═══════════════════════════════════════════ -->

            <!-- Panel — the primary grouping container. Subtle bg, no shadow. -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SoftBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="20,18" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Code text box -->
            <Style x:Key="CodeBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="{DynamicResource CodeBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Foreground" Value="{DynamicResource CodeFg}" />
            </Style>

            <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource CodeBox}">
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Background" Value="{DynamicResource CardMutedBg}" />
            </Style>

            <Style x:Key="SkillChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryFg}" />
                <Setter Property="Background" Value="{DynamicResource CardMutedBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4,24,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="4" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipShell" Property="Background" Value="{DynamicResource HoverBg}" />
                                    <Setter TargetName="ChipShell" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ChipShell" Property="Background" Value="{DynamicResource SelectedBg}" />
                                    <Setter TargetName="ChipShell" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SkillChipRemoveButton" TargetType="Button">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryFg}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RemoveShell" Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="×" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="12" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RemoveShell" Property="Background" Value="{DynamicResource ErrorSubtleBg}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Numbered step badge -->
            <Style x:Key="StepCircle" TargetType="Grid">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- Divider line -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
                <Setter Property="Margin" Value="0,16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
