<Application x:Class="PortableCodex.Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:PortableCodex.Native.Utils"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <utils:StepVisibilityConverter x:Key="StepVisibility" />
            <utils:StepBrushConverter x:Key="StepBrush" />
            <utils:StepForegroundConverter x:Key="StepForeground" />
            <utils:StepLineBrushConverter x:Key="StepLineBrush" />
            <utils:BoolToVisibilityConverter x:Key="BoolToVis" />
            <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <utils:StatusDotBrushConverter x:Key="StatusDot" />
            <utils:StateVisibilityConverter x:Key="StateVisibility" />
            <utils:InverseStateVisibilityConverter x:Key="StateVisibilityInverted" />
            <utils:DiffToFlowDocumentConverter x:Key="DiffToFlowDocument" />
            <utils:DiffHasContentConverter x:Key="DiffHasContent" />

            <!-- ═══════════════════════════════════════════
                 DESIGN TOKENS  (opaque modern dark)
                 The runtime source of truth is ApplyTheme()
                 in MainViewModel.Theme.cs — it overwrites
                 these at startup for the active light/dark
                 palette. Keep the two in sync; the values
                 below are the dark defaults for design time.
                 ═══════════════════════════════════════════ -->

            <!-- Accent — single violet, no competing hue -->
            <SolidColorBrush x:Key="AccentBrush"          Color="#8B5CF6" />
            <SolidColorBrush x:Key="AccentHoverBrush"      Color="#A78BFA" />
            <SolidColorBrush x:Key="AccentPressedBrush"    Color="#7C3AED" />
            <SolidColorBrush x:Key="AccentSubtleBg"        Color="#2A2440" />
            <SolidColorBrush x:Key="OnAccentFg"            Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush"          Color="#34D399" />
            <SolidColorBrush x:Key="ErrorBrush"            Color="#FB7185" />

            <!-- Surfaces — opaque neutral zinc, layered by elevation -->
            <SolidColorBrush x:Key="AppBg"                 Color="#0B0B0D" />
            <SolidColorBrush x:Key="PanelBg"               Color="#121214" />
            <SolidColorBrush x:Key="CardBg"                Color="#161618" />
            <SolidColorBrush x:Key="CardMutedBg"           Color="#1C1C1F" />
            <SolidColorBrush x:Key="ElevatedBg"            Color="#202023" />
            <SolidColorBrush x:Key="HoverBg"               Color="#232327" />
            <SolidColorBrush x:Key="SelectedBg"            Color="#241E33" />
            <SolidColorBrush x:Key="SelectedBorder"        Color="#4C3A7A" />
            <SolidColorBrush x:Key="SurfaceBg"             Color="#0B0B0D" />

            <!-- Text — stepped contrast, all legible on dark -->
            <SolidColorBrush x:Key="PrimaryFg"             Color="#FAFAFA" />
            <SolidColorBrush x:Key="SecondaryFg"           Color="#C8C8CC" />
            <SolidColorBrush x:Key="MutedFg"               Color="#9A9AA2" />
            <SolidColorBrush x:Key="TertiaryFg"            Color="#74747C" />

            <!-- Borders — hairline -->
            <SolidColorBrush x:Key="SubtleBorder"          Color="#2A2A2E" />
            <SolidColorBrush x:Key="SoftBorder"            Color="#1F1F22" />
            <SolidColorBrush x:Key="DividerBrush"          Color="#232327" />

            <!-- Code -->
            <SolidColorBrush x:Key="CodeBg"                Color="#0E0E10" />
            <SolidColorBrush x:Key="CodeFg"                Color="#D4D4D8" />

            <!-- Semantic states — opaque tints -->
            <SolidColorBrush x:Key="SuccessSubtleBg"       Color="#14271F" />
            <SolidColorBrush x:Key="SuccessSubtleBorder"   Color="#1F4D3A" />
            <SolidColorBrush x:Key="SuccessSubtleFg"       Color="#6EE7B7" />
            <SolidColorBrush x:Key="PendingSubtleBg"       Color="#1C1C1F" />
            <SolidColorBrush x:Key="WarningSubtleBg"       Color="#2A2113" />
            <SolidColorBrush x:Key="WarningSubtleBorder"   Color="#4D3B14" />
            <SolidColorBrush x:Key="WarningSubtleFg"       Color="#FCD34D" />
            <SolidColorBrush x:Key="ErrorSubtleBg"         Color="#2A1620" />
            <SolidColorBrush x:Key="ErrorSubtleBorder"     Color="#4D2230" />
            <SolidColorBrush x:Key="ErrorSubtleFg"         Color="#FDA4AF" />

            <!-- Step indicator -->
            <SolidColorBrush x:Key="StepActiveBg"          Color="#8B5CF6" />
            <SolidColorBrush x:Key="StepCompleteBg"        Color="#34D399" />
            <SolidColorBrush x:Key="StepInactiveBg"        Color="#2E2E33" />
            <SolidColorBrush x:Key="StepLineActive"        Color="#8B5CF6" />
            <SolidColorBrush x:Key="StepLineInactive"      Color="#2A2A2E" />

            <!-- ═══════════════════════════════════════════
                 TYPOGRAPHY
                 ═══════════════════════════════════════════ -->

            <Style x:Key="PageHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
            </Style>

            <Style x:Key="PageSubheading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="24" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryFg}" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
            </Style>

            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryFg}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="20" />
            </Style>

            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryFg}" />
            </Style>

            <!-- ═══════════════════════════════════════════
                 COMPONENT STYLES
                 ═══════════════════════════════════════════ -->

            <!-- Flat grouping container — no fill, no border, no rounding.
                 Kept as a zero-chrome wrapper so existing layouts that
                 reference it stay structurally intact. -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Code text box -->
            <Style x:Key="CodeBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="{DynamicResource CodeBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Foreground" Value="{DynamicResource CodeFg}" />
            </Style>

            <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource CodeBox}">
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Background" Value="{DynamicResource CardMutedBg}" />
            </Style>

            <Style x:Key="SkillChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryFg}" />
                <Setter Property="Background" Value="{DynamicResource CardMutedBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4,24,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChipShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="4" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipShell" Property="Background" Value="{DynamicResource HoverBg}" />
                                    <Setter TargetName="ChipShell" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ChipShell" Property="Background" Value="{DynamicResource SelectedBg}" />
                                    <Setter TargetName="ChipShell" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SkillChipRemoveButton" TargetType="Button">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryFg}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RemoveShell" Background="{TemplateBinding Background}" CornerRadius="0">
                                <TextBlock Text="×" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="12" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RemoveShell" Property="Background" Value="{DynamicResource ErrorSubtleBg}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorSubtleFg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Numbered step badge -->
            <Style x:Key="StepCircle" TargetType="Grid">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- Divider line -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
                <Setter Property="Margin" Value="0,16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
