<ui:FluentWindow x:Class="PortableCodex.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:PortableCodex.Native.Views"
        Title="Portable Codex"
        Width="1100" Height="780"
        MinWidth="860" MinHeight="600"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Title Bar ─── -->
        <ui:TitleBar Grid.Row="0" Title="Portable Codex" ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            Background="{Binding LocalRelayState, Converter={StaticResource StatusDot}}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedFg}" Text="{Binding LocalRelayMessage}" Margin="0,0,18,0" />
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            Background="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedFg}" Text="{Binding TunnelBarText}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ─── Content Shell ─── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Wizard Stepper (hidden on dashboard/diff) ─── -->
            <Border Grid.Row="0" Padding="0,10,0,10" Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Step items as simple text with active indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Border Width="22" Height="22" CornerRadius="11">
                            <Border.Background>
                                <Binding Path="CurrentStep" Converter="{StaticResource StepBrush}" ConverterParameter="0" />
                            </Border.Background>
                            <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Setup" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding CurrentStep, Converter={StaticResource StepForeground}, ConverterParameter=0}" />
                    </StackPanel>

                    <Rectangle Width="24" Height="1.5" Margin="8,0" VerticalAlignment="Center"
                               Fill="{Binding CurrentStep, Converter={StaticResource StepLineBrush}, ConverterParameter=0}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Border Width="22" Height="22" CornerRadius="11">
                            <Border.Background>
                                <Binding Path="CurrentStep" Converter="{StaticResource StepBrush}" ConverterParameter="1" />
                            </Border.Background>
                            <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding StepCreateLabel}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding CurrentStep, Converter={StaticResource StepForeground}, ConverterParameter=1}" />
                    </StackPanel>

                    <Rectangle Width="24" Height="1.5" Margin="8,0" VerticalAlignment="Center"
                               Fill="{Binding CurrentStep, Converter={StaticResource StepLineBrush}, ConverterParameter=1}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Border Width="22" Height="22" CornerRadius="11">
                            <Border.Background>
                                <Binding Path="CurrentStep" Converter="{StaticResource StepBrush}" ConverterParameter="2" />
                            </Border.Background>
                            <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding StepConfigureLabel}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding CurrentStep, Converter={StaticResource StepForeground}, ConverterParameter=2}" />
                    </StackPanel>

                    <Rectangle Width="24" Height="1.5" Margin="8,0" VerticalAlignment="Center"
                               Fill="{Binding CurrentStep, Converter={StaticResource StepLineBrush}, ConverterParameter=2}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <Border Width="22" Height="22" CornerRadius="11">
                            <Border.Background>
                                <Binding Path="CurrentStep" Converter="{StaticResource StepBrush}" ConverterParameter="3" />
                            </Border.Background>
                            <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Workspaces" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding CurrentStep, Converter={StaticResource StepForeground}, ConverterParameter=3}" />
                    </StackPanel>

                    <Rectangle Width="24" Height="1.5" Margin="8,0" VerticalAlignment="Center"
                               Fill="{Binding CurrentStep, Converter={StaticResource StepLineBrush}, ConverterParameter=3}" />

                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11">
                            <Border.Background>
                                <Binding Path="CurrentStep" Converter="{StaticResource StepBrush}" ConverterParameter="4" />
                            </Border.Background>
                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12" Foreground="White" />
                        </Border>
                        <TextBlock Text="Ready" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding CurrentStep, Converter={StaticResource StepForeground}, ConverterParameter=4}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ─── Page content ─── -->
            <Grid Grid.Row="1">
                <views:SetupView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=0}" />
                <views:CreateGptView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=1}" />
                <views:ConfigureActionView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=2}" />
                <views:WorkspacesView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=3}" />
                <views:DashboardView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=4}" />
                <views:DiffViewerView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=5}" />
            </Grid>

            <!-- ─── Wizard bottom nav ─── -->
            <Border Grid.Row="2" Padding="36,12" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <ui:Button HorizontalAlignment="Left" Appearance="Secondary" Content="← Back"
                               Command="{Binding PrevStepCommand}"
                               Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVis}}" />
                    <ui:Button HorizontalAlignment="Right" Appearance="Primary"
                               Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
