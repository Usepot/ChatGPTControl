<ui:FluentWindow x:Class="PortableCodex.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:PortableCodex.Native.Views"
        Title="Portable Codex"
        Width="1100" Height="780"
        MinWidth="860" MinHeight="600"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Title Bar ─── -->
        <ui:TitleBar Grid.Row="0" Title="Portable Codex" ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            Background="{Binding LocalRelayState, Converter={StaticResource StatusDot}}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedFg}" Text="{Binding LocalRelayMessage}" Margin="0,0,18,0" />
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            Background="{Binding TunnelState, Converter={StaticResource StatusDot}}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedFg}" Text="{Binding TunnelBarText}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ─── Content Shell ─── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Wizard Stepper (hidden on dashboard/diff) ─── -->
            <Border Grid.Row="0" Padding="0,10,0,10" Background="Transparent"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ItemsControl ItemsSource="{Binding WizardSteps}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- Badge -->
                                <Grid Width="26" Height="26">
                                    <!-- soft active ring -->
                                    <Ellipse x:Name="Ring" Width="26" Height="26"
                                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                             Opacity="0" />
                                    <Border x:Name="Badge" Width="20" Height="20" CornerRadius="10"
                                            Background="{DynamicResource StepInactiveBg}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TertiaryFg}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsCheckmark, Converter={StaticResource InverseBoolToVis}}" />
                                            <ui:SymbolIcon Symbol="Checkmark20" FontSize="12"
                                                           Foreground="{DynamicResource OnAccentFg}"
                                                           Visibility="{Binding IsCheckmark, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="Lbl" Text="{Binding Label}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{DynamicResource TertiaryFg}" />

                                <!-- Connector -->
                                <Rectangle x:Name="Connector" Width="30" Height="2" Margin="14,0"
                                           RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                                           Fill="{DynamicResource StepLineInactive}"
                                           Visibility="{Binding ShowConnector, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="active">
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource StepActiveBg}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource OnAccentFg}" />
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource PrimaryFg}" />
                                    <Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="complete">
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource StepCompleteBg}" />
                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource OnAccentFg}" />
                                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource SecondaryFg}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectorComplete}" Value="True">
                                    <Setter TargetName="Connector" Property="Fill" Value="{DynamicResource StepLineActive}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ─── Page content ─── -->
            <Grid Grid.Row="1">
                <views:SetupView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=0}" />
                <views:CreateGptView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=1}" />
                <views:ConfigureActionView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=2}" />
                <views:WorkspacesView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=3}" />
                <views:DashboardView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=4}" />
                <views:DiffViewerView Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=5}" />
            </Grid>

            <!-- ─── Wizard bottom nav ─── -->
            <Border Grid.Row="2" Padding="36,12" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <ui:Button HorizontalAlignment="Left" Appearance="Secondary" Content="← Back"
                               Command="{Binding PrevStepCommand}"
                               Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVis}}" />
                    <ui:Button HorizontalAlignment="Right" Appearance="Primary"
                               Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
